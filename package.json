{
  "name": "gtrsg-poll-bot",
  "version": "2.0.0",
  "description": "Automates weekly Telegram poll release for GTRSG flexi wheelchair/PSA slots",
  "main": "src/localServer.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/localServer.js",
    "dev-telegram": "node scripts/dev-telegram.js",
    "migrate": "node scripts/migrate.js",
    "migrate:multi-tenant": "node scripts/migrate-to-multi-tenant.js",
    "set-webhook": "node scripts/set-webhook.js",
    "delete-webhook": "node scripts/delete-webhook.js",
    "check": "node scripts/check.js",
    "build": "npm run check",
    "lint": "npm run check",
    "verify:migration": "node scripts/verify-migration.js",
    "test": "node --test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "lucide": "^0.468.0",
    "postgres": "^3.4.9"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
