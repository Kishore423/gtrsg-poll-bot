# --- Telegram bot ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Optional second bot only when WHCL and PSA require operational isolation.
TELEGRAM_TOKEN_WHCL=
TELEGRAM_TOKEN_PSA=
# Shared secret Telegram echoes back on every webhook call (any random string).
TELEGRAM_WEBHOOK_SECRET=

# --- Supabase PostgreSQL and Auth --------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# DB_DRIVER=memory
REQUIRE_ADMIN_AUTH=true
APP_SESSION_SECRET=
TELEGRAM_AUTH_BOT=PSA
# Temporary local-only compatibility workflow. Keep false in production.
ENABLE_LEGACY_WORKFLOW=false

# --- Cron protection ---------------------------------------------------------
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to the cron endpoints.
CRON_SECRET=

# --- Deployment / misc -------------------------------------------------------
APP_URL=
PORT=3000
# Prefix poll questions with [Wheelchair]/[PSA] (only useful while testing in
# one shared group; leave off once each bot is in its own group).
LABEL_SERVICE_IN_POLL=
# Hour (0-23, Singapore time) on the day BEFORE the slot date when the
# confirmation auto-sends, regardless of fill status.
CONFIRMATION_HOUR=8
CONFIRMATION_TIMEZONE_OFFSET=+08:00
